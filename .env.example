# 演示模式使用本地合成资料。可切换为 project。
DHUB_DATA_MODE=demo
DHUB_DB_PATH=.local/runs.sqlite3
DHUB_RUN_TIMEOUT=300

# openai_chat 调用兼容 Chat Completions 的网关。
LLM_PROVIDER=offline
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=40
# LLM_MAX_TOKENS=4000

# project 模式的数据位置
DHUB_CONFLUENCE_MANIFEST=data/confluence/manifest.json
DHUB_REPOS_FILE=data/repositories.json
# DHUB_CODEGRAPH_ADAPTER=intranet_codegraph:create_adapter
