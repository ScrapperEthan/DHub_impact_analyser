# 演示模式使用本地合成资料。可切换为 project。
DHUB_DATA_MODE=demo
DHUB_DB_PATH=.local/runs.sqlite3
DHUB_RUN_TIMEOUT=300

# 默认离线演示。可显式选 local_responses 或 openai_chat。
# local_responses 默认使用 http://127.0.0.1:4141/v1。
LLM_PROVIDER=offline
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=40
# DHUB_LLM_MODEL=your-available-model
# LLM_REASONING_EFFORT=low
# LLM_MAX_TOKENS=4000

# project 模式的数据位置
DHUB_CONFLUENCE_MANIFEST=data/confluence/manifest.json
# 将 decision-engine-instant-decision-svc 的实际路径及 dev 分支写入此文件。
DHUB_REPOS_FILE=data/repositories.json
# DHUB_CODEGRAPH_ADAPTER=intranet_codegraph:create_adapter
